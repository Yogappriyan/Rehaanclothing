rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if request is from an authorized admin
    function isAdmin() {
      return (request.auth != null && (
        request.auth.token.email in ['animeflicks2310@gmail.com', 'houseofrehaan@gmail.com'] ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true)
      ));
    }

    // Public catalog browsing
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /lookbooks/{lookbookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons: Inactive/draft coupons are protected; only active coupons or admin can read
    match /coupons/{couponId} {
      allow read: if (resource.data.active == true) || isAdmin();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.approved == true || isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Contact Requests & Customer Enquiries: Strictly admin only
    match /contactRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Automated Email Logs & Scheduled Reports: Strictly admin only
    match /emailNotifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    match /scheduledReports/{reportId} {
      allow read, write: if isAdmin();
    }

    // Orders security:
    // - List/Query is strictly restricted to authorized admins or the matching authenticated user
    // - Single document lookup (get) allows real-time status tracking for order holders with exact Order ID
    match /orders/{orderId} {
      allow create: if true;
      allow get: if true;
      allow list: if isAdmin() || (
        request.auth != null && (
          resource.data.customerId == request.auth.uid ||
          resource.data.email == request.auth.token.email
        )
      );
      allow update, delete: if isAdmin();
    }

    // Admin profiles & access control: protected from enumeration
    match /admins/{adminId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == adminId);
      allow write: if isAdmin();
    }

    // User profile and private wishlist
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }
  }
}
