{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A boutique fashion garment or accessory sold by House Of Rehaan",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The name of the garment" },
        "slug": { "type": "string", "description": "URL slug" },
        "brand": { "type": "string", "description": "Brand name" },
        "category": { "type": "string", "description": "Primary category" },
        "subcategory": { "type": "string", "description": "Subcategory" },
        "description": { "type": "string", "description": "Full garment details" },
        "price": { "type": "number", "description": "Regular price in INR" },
        "salePrice": { "type": "number", "description": "Discounted price in INR" },
        "images": { "type": "array", "description": "Image gallery URLs" },
        "sizes": { "type": "array", "description": "Available garment sizes" },
        "fabric": { "type": "string", "description": "Fabric type" },
        "status": { "type": "string", "description": "Stock status" }
      },
      "required": ["name", "slug", "category", "price"]
    },
    "Category": {
      "title": "Category",
      "description": "A fashion product category in the store",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the category" },
        "slug": { "type": "string", "description": "Slug of the category" },
        "description": { "type": "string", "description": "Description of the collection" },
        "image": { "type": "string", "description": "Cover banner image URL" },
        "active": { "type": "boolean", "description": "Whether the category is active" },
        "displayOrder": { "type": "number", "description": "Display sort order" }
      },
      "required": ["name", "slug"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase transaction record",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "customerEmail": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["orderNumber", "customerEmail", "total", "status"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount voucher and coupon",
      "type": "object",
      "properties": {
        "code": { "type": "string", "description": "Uppercase coupon code" },
        "discountType": { "type": "string", "description": "percentage or fixed" },
        "discountValue": { "type": "number", "description": "Discount rate or amount" },
        "minimumOrder": { "type": "number", "description": "Minimum purchase required" },
        "maximumDiscount": { "type": "number", "description": "Max discount amount cap" },
        "active": { "type": "boolean", "description": "Whether coupon is active" }
      },
      "required": ["code", "discountType", "discountValue", "active"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Storefront catalog items"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Storefront clothing categories"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Promotional discount coupons"
    }
  }
}
